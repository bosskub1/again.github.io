local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId
local FILENAME = _G.Config.FileName

local currentServerHopTime = _G.Config.ServerHopDelay
local serverHopStartTick = tick()
local isHopping = false

local function ServerHop()
    if isHopping then
        return
    end

    isHopping = true

    local JobId = game.JobId

    while true do
        pcall(function()
            statusLabel.Text = "Status : Searching server..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        end)

        local Url =
            "https://games.roblox.com/v1/games/" ..
            PlaceId ..
            "/servers/Public?sortOrder=Asc&limit=100"

        local success, result = pcall(function()
            return game:HttpGet(Url)
        end)

        if success and result then
            local decodeSuccess, decodedResult = pcall(function()
                return HttpService:JSONDecode(result)
            end)

            if decodeSuccess
            and decodedResult
            and decodedResult.data then

                local ValidServers = {}

                for _, server in ipairs(decodedResult.data or {}) do
                    if type(server) == "table"
                    and server.id ~= JobId
                    and tonumber(server.playing)
                    and tonumber(server.maxPlayers)
                    and server.playing < (server.maxPlayers - #_G.Config.AltUsernames - 1)
                    and server.playing > 0 then

                        table.insert(
                            ValidServers,
                            server.id
                        )
                    end
                end

                if #ValidServers > 0 then
                    local RandomServer =
                        ValidServers[
                            math.random(1, #ValidServers)
                        ]

                    pcall(function()
                        writefile(FILENAME, RandomServer)
                    end)

                    pcall(function()
                        statusLabel.Text = "Status : Teleporting..."
                        statusLabel.TextColor3 = Color3.fromRGB(100,255,100)
                    end)

                    task.wait(1)

                    local tpSuccess, tpError = pcall(function()
                        TeleportService:TeleportToPlaceInstance(
                            PlaceId,
                            RandomServer,
                            LocalPlayer
                        )
                    end)

                    if tpSuccess then
                        serverHopStartTick = tick()
                        break
                    else
                        warn("Teleport Failed:", tpError)
                    end
                end
            end
        end

        warn("Retrying Server Hop...")
        task.wait(2)
    end

    task.delay(15, function()
        isHopping = false
    end)
end

local function altFollowMain()
    pcall(function()
        if not isfile(FILENAME) then
            return
        end

        local success, targetId = pcall(function()
            return readfile(FILENAME)
        end)

        if success
        and targetId
        and targetId ~= ""
        and targetId ~= game.JobId then

            statusLabel.Text = "Status : Following main!"
            statusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)

            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                targetId,
                LocalPlayer
            )
        end
    end)
end

task.spawn(function()
    while true do
        pcall(function()
            local elapsed = tick() - serverHopStartTick
            local remain = math.max(0, currentServerHopTime - elapsed)

            local m = math.floor(remain / 60)
            local s = math.floor(remain % 60)

            timerLabel.Text = string.format(
                "Server Hop : %02d:%02d",
                m,
                s
            )

            if remain <= 5 then
                mainStroke.Color = Color3.fromRGB(255, 100, 100)

                if remain <= 0 then
                    if isMain then
                        if not isHopping then
                            task.spawn(ServerHop)
                        end
                    else
                        task.spawn(altFollowMain)
                    end
                end
            else
                mainStroke.Color = _G.Config.UiStroke
            end
        end)

        task.wait(1)
    end
end)

if isMain then
    task.spawn(function()

-- Timer Update
task.spawn(function()
    while running do
        local elapsed = tick() - startTime
        local m = math.floor(elapsed / 60)
        local s = math.floor(elapsed % 60)
        timerLabel.Text = string.format("Time: %02d:%02d", m, s)
        task.wait(1)
    end
end)

-- Auto Emote Spin
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local comm = LocalPlayer.Character:FindFirstChild("Communicate")
            if comm then comm:FireServer({ Goal = "Emote Spin" }) end
        end)
    end
end)

-- Main Farm Loop
if isMain then
    task.spawn(function()
        while true do
            task.wait(0.1)
            local target = nil
            local readyCount = 0
            
            for _, name in ipairs(_G.Config.AltUsernames) do
                local p = Players:FindFirstChild(name)
                if p and isAltAtFarmLocation(p) and not isAltDead(p) then
                    readyCount = readyCount + 1
                    if not target then target = p end
                end
            end

            if target then
                statusLabel.Text = "Status: Farming ("..readyCount.." Alts)"
                statusLabel.TextColor3 = Color3.fromRGB(140, 255, 170)
                
                local targetHrp = getHRP(getChar(target))
                if targetHrp then
                    local lookVec = targetHrp.CFrame.LookVector
                    local behindPos = targetHrp.Position - (lookVec * _G.Config.BehindOffset)
                    
                    teleportTo(behindPos)
                    task.wait(0.2)
                    aimAtTarget(targetHrp.Position)
                    task.wait(0.5)
                    pressKey(Enum.KeyCode.Three) -- Skill 3
                    task.wait(1.0)
                    resetChar()
                    task.wait(2.0)
                end
            else
                statusLabel.Text = "Status: Waiting for Alts..."
                statusLabel.TextColor3 = _G.Config.StatusColor
            end
        end
    end)
else
    -- Alt Account Logic (Warp to Farm Location)
    task.spawn(function()
        while true do
            if not isAltAtFarmLocation(LocalPlayer) then
                statusLabel.Text = "Status: Going to Farm..."
                teleportTo(_G.Config.TargetCoord)
            else
                statusLabel.Text = "Status: Ready at Farm"
            end
            task.wait(1)
        end
    end)
end

-- Key Inputs
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
        running = not running
        sg.Enabled = running
    end
    if input.KeyCode == Enum.KeyCode.B then
        toggleBlackScreen()
    end
end)


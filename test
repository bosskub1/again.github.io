            pcall(function()
                if not isHopping and game.JobId ~= "" then
                    writefile(FILENAME, game.JobId)
                end
            end)
        end
    end)
else
    task.spawn(function()
        while true do
            altFollowMain()
            task.wait(5)
        end
    end)
end




